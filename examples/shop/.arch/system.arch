# Dự án mẫu để thử bộ kiểm chứng. Cố ý có sẵn hai vi phạm và hai import
# không phân giải được, để `archctl check` có thứ mà báo.

component Web      at src/web/**       @human #locked
component Order    at src/order/**     @human #locked
component Payment  at src/payment/**   @human #accepted
component Stock    at src/stock/**     @human #accepted
component Notify   at src/notify/**    @human #accepted
component User     at src/user/**      @human #accepted
external  Stripe   at "stripe"         @human #accepted

store OrderDB    owned_by Order    at "orders", "order_items"
store PaymentDB  owned_by Payment  at "payments", "refunds"

allow Web     -> Order, User
allow Order   -> Stock, Payment, Notify, OrderDB
allow Payment -> Stripe, PaymentDB
allow Stock   -> Notify
deny  * -> PaymentDB except Payment
deny  * -> Stripe   except Payment

flow PlaceOrder:                                    @human #locked
  validateCart -> reserveStock -> charge -> confirmOrder
  parallel: sendEmail, updateAnalytics
  on_fail(charge): releaseStock
  on_fail(confirmOrder): refund, releaseStock

contract Payment.charge:                            @human #locked
  requires      order.status == RESERVED
  ensures       ok  => payment.status == CAPTURED
                err => không có tiền nào bị chuyển
  errors        Declined | Timeout | Unavailable
  idempotent_by orderId
  latency       p99 < 800ms
  consistency   strong
  verify        contract_test, chaos_stripe_timeout

boundary Checkout contains Order, Stock, Payment:   @human #accepted
  isolation   Payment.down => Order vẫn nhận đơn, trạng thái PENDING_PAYMENT
  propagate   Declined -> user
  contain     Timeout, Unavailable
  retry       Payment.charge: 3 lần, backoff mũ, chỉ khi idempotent
  timeout     toàn luồng < 3s
  compensate  charge.fail => releaseStock
  verify      chaos_payment_down

# `updateAnalytics` cố ý không có trong mã: đó là một khai báo đã lạc hậu, và
# `archctl check` phải chỉ ra.

# Mỗi cách kiểm phải chỉ ra được một lệnh chạy được. Không có phần này thì
# `verify property_test` chỉ là một cái tên không dẫn tới đâu — và khi đó
# "đã có verify" vẫn chỉ là lời hứa, chỉ khác là không còn ai nhắc.
verify contract_test         runs "npm run test:contract"           @human #accepted
verify property_test         runs "npm run test:props"              @human #accepted
verify daily_reconcile       runs "npm run reconcile -- --check"    @human #accepted
verify dataflow              runs "npm run lint:pii"                @human #accepted
verify chaos_stripe_timeout  runs "npm run chaos -- stripe-timeout" @human #accepted
verify chaos_payment_down    runs "npm run chaos -- payment-down"   @human #accepted

invariant data   [Order]    order.total == sum(items.price * items.qty) verify property_test
invariant state  [Order]    CREATED -> RESERVED -> PAID -> SHIPPED verify property_test
invariant money  [system]   tổng tiền trừ khách == tổng tiền ghi nhận verify daily_reconcile
invariant access [system]   PII chỉ nằm trong User verify dataflow
