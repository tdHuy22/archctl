# Công cụ phân tích gói tin, bốn ngôn ngữ trong một repo.
# Cố ý chứa bốn vi phạm, mỗi ngôn ngữ một cái.

component Capture  at src/capture/**, src/main.rs   @human #locked
component Decode   at src/decode/**                 @human #accepted
component Report   at src/report.rs                 @human #accepted
component Native   at native/**                     @human #locked
component Tools    at tools/*.py                    @human #accepted
component ToolsLib at tools/lib/**                  @human #accepted
component Ctl      at cmd/**                        @human #accepted
component Stream   at internal/**                   @human #accepted

store Captures owned_by Capture at "packets", "sessions"   @human #locked

external LibPcap at "pcap.h"                        @human #locked
external LibC    at "stdio.h", "string.h"           @human #accepted
external NumPy   at "numpy"                         @human #accepted
external GoNet   at "net"                           @human #accepted

allow Capture  -> Decode, LibPcap
allow Decode   -> Report
allow Native   -> LibC
allow Tools    -> ToolsLib, NumPy
allow ToolsLib -> NumPy
allow Ctl      -> Stream
allow Stream   -> GoNet

# Chỉ Capture được chạm libpcap. Mọi nơi khác phải đi qua nó.
deny * -> LibPcap except Capture

# Hàm và từ khoá bị theo dõi. Khác với import, nhóm này được tìm thẳng trong
# dòng token nên không có vùng mù: FFI hay con trỏ hàm đều không giấu được.
api Unsafe     at "strcpy", "sprintf", "gets", "strcat", "alloca"   @human #locked
api Danger     at "eval", "pickle"                                  @human #locked
api RustUnsafe at "unsafe"                                          @human #accepted

deny * -> Unsafe
deny * -> Danger
deny * -> RustUnsafe except Decode
